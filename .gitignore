# Terraform state — may contain secrets, never commit
*.tfstate
*.tfstate.backup

# Terraform working directory — downloaded providers and modules
**/.terraform/

# Terraform lock file — commit this if you want reproducible provider versions across teammates
# .terraform.lock.hcl

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# AWS credentials — should never be in a repo
.env
*.pem

# Lambda build artifacts — installed for linux/x64, not your local platform
lambda/node_modules/
lambda.zip
